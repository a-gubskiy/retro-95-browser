{
  "manifest_version": 3,
  "name": "Classic 95 Browser Theme",
  "version": "0.1.0",
  "description": "A retro Chromium theme inspired by classic 90s desktop colors. Not affiliated with or endorsed by Microsoft.",
  "theme": {
    "colors": {
      "frame": [0, 0, 128],
      "frame_inactive": [128, 128, 128],
      "background_tab": [0, 0, 128],
      "background_tab_inactive": [0, 0, 128],
      "toolbar": [192, 192, 192],
      "toolbar_text": [0, 0, 0],
      "toolbar_button_icon": [0, 0, 0],
      "omnibox_background": [255, 255, 255],
      "omnibox_text": [0, 0, 0],
      "bookmark_text": [0, 0, 0],
      "tab_text": [0, 0, 0],
      "tab_background_text": [255, 255, 255],
      "tab_background_text_inactive": [255, 255, 255],
      "ntp_background": [0, 128, 128],
      "ntp_header": [192, 192, 192],
      "ntp_text": [255, 255, 255],
      "ntp_link": [255, 255, 255],
      "button_background": [192, 192, 192]
    }
  }
